{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "serviceAccount",
    "existingSecret",
    "config",
    "api",
    "worker"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "not": {
            "enum": [
              "latest"
            ]
          }
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "irsaRoleArn": {
          "type": "string",
          "pattern": "^$|^arn:aws[a-z-]*:iam::[0-9]{12}:role/.+$"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "config": {
      "type": "object",
      "properties": {
        "archiveProvider": {
          "enum": [
            "r2",
            "s3"
          ]
        },
        "rabbitmqPrefetch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "rabbitmqRetryDelaysMs": {
          "type": "string",
          "pattern": "^[0-9]+(,[0-9]+)*$"
        },
        "shutdownTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        }
      }
    },
    "api": {
      "type": "object",
      "required": [
        "resources"
      ],
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "containerPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "autoscaling": {
          "$ref": "#/definitions/autoscaling"
        },
        "readinessPath": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "worker": {
      "type": "object",
      "required": [
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "autoscaling": {
          "$ref": "#/definitions/autoscaling"
        }
      }
    }
  },
  "definitions": {
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ]
        },
        "limits": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ]
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  }
}
