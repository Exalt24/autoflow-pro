PORT=4000
NODE_ENV=development

SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

REDIS_URL=your_redis_url

CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_key
CLOUDFLARE_R2_BUCKET_NAME=your_bucket_name

# Archive target: r2 (default) or s3. With s3, the AWS SDK signs in with its usual sources
# (AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, a shared profile, or an IAM role).
ARCHIVE_PROVIDER=r2
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET_NAME=autoflow-archive-123456789012
# Only for a local emulator such as moto; leave unset for real AWS
# AWS_S3_ENDPOINT=http://localhost:5000

CORS_ORIGIN=http://localhost:3000