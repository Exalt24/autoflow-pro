# Line endings and binaries, enforced on every machine (autocrlf corrupted PDFs and left shell scripts and Dockerfiles CRLF, 2026-10-13).
.env* text eol=lf
*.env text eol=lf
*.gif binary
*.ico binary
*.sh text eol=lf
Dockerfile text eol=lf
*.tf text eol=lf
*.yml text eol=lf
*.go text eol=lf
deploy/aws/tfgraph/testdata/** text eol=lf
deploy/aws/tfgraph/go.mod text eol=lf
serverless/**/*.py text eol=lf
serverless/**/*.json text eol=lf
serverless/*.txt text eol=lf
serverless/*.ini text eol=lf
